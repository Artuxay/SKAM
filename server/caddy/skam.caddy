# Дописывается в конец volumes/proxy/caddy/Caddyfile (блок api.skam-messenger.ru там уже есть).
# Сайт собирает build.sh в /opt/skam-test/site, в контейнер он смонтирован как /srv/skam-test.
# Статьи (0.4.0): любой путь /a/... отдаёт /a/index.html — строки @skamArticle добавляет server/apply-caddy.sh.

skam-messenger.ru {
    root * /srv/skam-test
    @skamArticle path /a/*
    rewrite @skamArticle /a/index.html
    header @skamArticle Cache-Control "no-cache"
    encode zstd gzip
    file_server
    @fresh path / /index.html *.html /sw.js /manifest.webmanifest
    header @fresh Cache-Control "no-cache"
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    header -server
}

www.skam-messenger.ru {
    redir https://skam-messenger.ru{uri} permanent
}

test.skam-messenger.ru {
    root * /srv/skam-test
    @skamArticle path /a/*
    rewrite @skamArticle /a/index.html
    header @skamArticle Cache-Control "no-cache"
    encode zstd gzip
    file_server
    header X-Robots-Tag "noindex, nofollow"
    header /sw.js Cache-Control "no-cache"
    header -server
}
