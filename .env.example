# Скопируйте в .env и подставьте значения из Supabase → Project Settings → API Keys.
# URL проекта
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) или legacy anon key (eyJ...). Это публичный ключ —
# он попадает в браузер, данные защищают RLS-политики. НИКОГДА не кладите сюда service_role / secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Необязательно: длина кода из письма (Supabase → Authentication → Sign In / Providers → Email → Email OTP length).
# VITE_EMAIL_OTP_LENGTH=8
# Необязательно: TURN-сервер для звонков — нужен, когда напрямую между участниками не пробиться.
# VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
